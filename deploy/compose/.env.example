# Copy to .env next to compose.yaml and edit.

# Database password for the bundled PostgreSQL (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Name screens and browsers use to reach this server; goes into the generated
# TLS certificate and the public URL https://CUELIGHT_HOSTNAME:CUELIGHT_PORT.
CUELIGHT_HOSTNAME=cuelight.local
# Extra IP addresses for the certificate (comma-separated), e.g. the LAN IP.
CUELIGHT_IPS=127.0.0.1
# Host port; the public URL uses it, so keep host and URL ports the same.
CUELIGHT_PORT=8443
# Shown to people joining this network from the desktop app.
CUELIGHT_NETWORK_NAME=Cuelight

# Image tag to build (or an image you built/pushed elsewhere).
# CUELIGHT_IMAGE=cuelight-control:0.2.0
