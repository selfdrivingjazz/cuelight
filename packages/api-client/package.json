{
  "name": "@cuelight/api-client",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/generated.ts",
    "check-generated": "git diff --exit-code -- src/generated.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
