<?xml version="1.0" encoding="utf-8"?>
<!-- Trust user-installed CAs so a private control-server CA (e.g. cable-dev's) can be installed in Android settings. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
