{
  "name": "@cuelight/node-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Cuelight player node with bundled Chromium",
  "author": "Cuelight contributors",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "sidecars": "node scripts/build-sidecars.mjs",
    "sidecars:all": "node scripts/build-sidecars.mjs --all",
    "dev": "pnpm sidecars && concurrently -k \"vite --host 127.0.0.1 --port 4175 --strictPort\" \"wait-on http://127.0.0.1:4175 && tsc -p tsconfig.main.json && electron .\"",
    "build": "vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "start": "pnpm sidecars && pnpm build && electron .",
    "dist": "pnpm sidecars && pnpm build && electron-builder"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.jmilldotdev.cuelight",
    "productName": "Cuelight",
    "executableName": "Cuelight",
    "artifactName": "Cuelight-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "extraResources": [
      {
        "from": "resources/bin/current",
        "to": "bin"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  }
}
