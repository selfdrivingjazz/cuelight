{
  "name": "cuelight-workspace",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "seed:dev": "node scripts/seed-dev.mjs",
    "generate": "pnpm --filter @cuelight/api-client generate",
    "check": "node scripts/check-version.mjs && pnpm generate && pnpm -r typecheck && pnpm --filter @cuelight/api-client check-generated",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @cuelight/controller-web --filter @cuelight/website-node build && node scripts/embed-web.mjs --require",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @cuelight/controller-web e2e"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
